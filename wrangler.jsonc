{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leela-analytics",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.leelaanalytics.com,https://leelaanalytics.com",
    "CONTACT_FROM": "",
    "CONTACT_TO": "hello@leelaanalytics.com"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026101601",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
